server {
        listen 80;
        root /var/www/html;
        index index.html index.htm index.nginx-debian.html;
        location / {
                try_files $uri $uri/ /index.html;
        }
}

server {
        listen 443;
        root /var/www/html;
        index index.html index.htm index.nginx-debian.html;
        ssl on;
        ssl_certificate /etc/nginx/ssl/_.ca;
        ssl_certificate_key /etc/nginx/ssl/_.private;
        ssl_prefer_server_ciphers on;
        client_body_buffer_size 1280k;
        client_max_body_size 1000M;
        location / {
                try_files $uri $uri/ /index.html;
        }
}

